<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
	  <LangVersion>10.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	
		  <!-- Propriétés NuGet -->
	  <!-- Propriétés NuGet -->
	  <PackageId>MatthL.ResultLogger</PackageId>
	  <Title>ResultLogger</Title>
	  <Version>0.9.0</Version>
	  <Authors>Matthieu L</Authors>
	  <Company>Matthieu L</Company>
	  <Description>Simple result pattern with integrated logging for .NET. Handle success/failure cases with automatic logging.</Description>
	  <PackageTags>result;logging;error-handling;result-pattern;functional</PackageTags>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <RepositoryUrl>https://github.com/LapercheMatthieu/ResultLogger</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/LapercheMatthieu/ResultLogger</PackageProjectUrl>

	  <!-- Build -->
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
	</ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\MatthL.ResultLogger.Core\MatthL.ResultLogger.Core.csproj" />
	<None Include="README.md" Pack="true" PackagePath="\" />
	<None Include="LICENCE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
